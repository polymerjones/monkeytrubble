# Only the Monkey Trubble game is tracked.
/*
!/.gitignore
!/README.md
!/web/
!/MonkeyTrubbleIOS/
!/MonkeyTrubbleAndroid/
!/source/
!/holo-lab/
!/docs/
!/.github/
!/.claude/
/.claude/*
!/.github/
!/.claude/skills/

# Family cards live outside the repo (see ~/monkeytrubble-private); never track them.
/secret-stack/

# macOS and Xcode per-user files
.DS_Store
xcuserdata/
*.xcuserstate

# Xcode build output
MonkeyTrubbleIOS/build/
