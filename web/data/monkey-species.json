  "species": [
    {"id":"chimpanzee","commonName":"Chimpanzee","scientificName":"Pan troglodytes","group":"great ape","facts":["Native to forests and savannas of equatorial Africa.","Lives in complex social communities and shows tool use, cooperative hunting, and cultural transmission.","Communicates through vocalizations, facial expressions, and gestures."],"sourceRefs":["youtube-lDAFF58qBx0#chimpanzee"]},
    {"id":"mangabey","commonName":"Mangabey","scientificName":null,"taxonScope":"Cercocebus and Lophocebus","group":"Old World monkey","facts":["Mangabeys occur in African forests and include both arboreal and terrestrial groups.","They have cheek pouches for temporarily storing food while foraging.","Their diet of fruit, seeds, and invertebrates makes them important seed dispersers."],"sourceRefs":["youtube-lDAFF58qBx0#mangabey"]},
    {"id":"proboscis-monkey","commonName":"Proboscis Monkey","scientificName":"Nasalis larvatus","group":"Old World monkey","facts":["Endemic to mangrove and riverine habitats on Borneo.","Partially webbed feet make it an excellent swimmer.","The male’s large nose may amplify calls and function as a visual signal."],"sourceRefs":["youtube-lDAFF58qBx0#proboscis-monkey"]},
    {"id":"agile-gibbon","commonName":"Agile Gibbon","scientificName":"Hylobates agilis","group":"lesser ape","facts":["A canopy-dwelling ape of Southeast Asian rainforests.","Mated pairs sing elaborate territorial duets.","Its long arms support fast brachiation between trees."],"sourceRefs":["youtube-lDAFF58qBx0#agile-gibbon"]},
    {"id":"aye-aye","commonName":"Aye-aye","scientificName":"Daubentonia madagascariensis","group":"lemur","facts":["A nocturnal lemur endemic to Madagascar.","It taps wood to locate larvae, gnaws an opening, and extracts prey with an elongated middle finger.","Its incisors grow continuously."],"sourceRefs":["youtube-lDAFF58qBx0#aye-aye"]},
    {"id":"indri","commonName":"Indri","scientificName":"Indri indri","group":"lemur","facts":["The largest living lemur and native to eastern Madagascar.","Its far-carrying songs help family groups communicate through dense forest.","Powerful hind legs enable long leaps between trees."],"sourceRefs":["youtube-lDAFF58qBx0#indri-lemur"]},
    {"id":"howler-monkey","commonName":"Howler Monkey","scientificName":null,"taxonScope":"Alouatta","group":"New World monkey","facts":["An enlarged hyoid apparatus amplifies its territorial roars.","Its prehensile tail acts as a fifth limb.","A leaf-heavy diet leads it to spend much of the day resting and digesting."],"sourceRefs":["youtube-lDAFF58qBx0#howler-monkey"]},
    {"id":"hamadryas-baboon","commonName":"Hamadryas Baboon","scientificName":"Papio hamadryas","group":"Old World monkey","facts":["Native to the Horn of Africa and the Arabian Peninsula.","Its multi-level society combines one-male units into clans and larger troops.","Groups often sleep on cliffs for protection."],"sourceRefs":["youtube-lDAFF58qBx0#hamadryas"]},
    {"id":"spider-monkey","commonName":"Spider Monkey","scientificName":null,"taxonScope":"Ateles","group":"New World monkey","facts":["Long limbs and a powerful prehensile tail support highly acrobatic canopy travel.","Communities split into smaller daytime foraging parties and reunite later.","Fruit eating makes spider monkeys important seed dispersers."],"sourceRefs":["youtube-lDAFF58qBx0#spider-monkey"]},
    {"id":"silvery-gibbon","commonName":"Silvery Gibbon","scientificName":"Hylobates moloch","group":"lesser ape","facts":["Endemic to the remaining rainforests of Java.","Pairs use loud songs to reinforce bonds and advertise territory.","It travels through the canopy primarily by brachiation."],"sourceRefs":["youtube-lDAFF58qBx0#silver-gibbon"]},
    {"id":"golden-lion-tamarin","commonName":"Golden Lion Tamarin","scientificName":"Leontopithecus rosalia","group":"New World monkey","facts":["Native to Brazil’s Atlantic coastal forest.","Its long fingers probe bark and crevices for insects and small prey.","Family groups cooperate in caring for infants, which are often twins."],"sourceRefs":["youtube-lDAFF58qBx0#golden-lion-tamarin"]},
    {"id":"siamang","commonName":"Siamang","scientificName":"Symphalangus syndactylus","group":"lesser ape","facts":["The largest gibbon, native to Sumatra and the Malay Peninsula.","An inflatable throat sac amplifies its resonant calls.","Pairs perform coordinated songs that carry through the forest."],"sourceRefs":["youtube-lDAFF58qBx0#siamang"]},
    {"id":"capuchin-monkey","commonName":"Capuchin Monkey","scientificName":null,"taxonScope":"Cebus and Sapajus","group":"New World monkey","facts":["Capuchins are adaptable omnivores of Central and South America.","They are accomplished tool users and problem solvers.","Their dexterous hands help them manipulate many kinds of food."],"sourceRefs":["youtube-lDAFF58qBx0#capuchin-monkey"]},
    {"id":"pileated-gibbon","commonName":"Pileated Gibbon","scientificName":"Hylobates pileatus","group":"lesser ape","facts":["Native to forests of Thailand, Cambodia, and Laos.","Adult males and females have strongly contrasting coat colors.","Pairs defend territories with elaborate morning duets."],"sourceRefs":["youtube-lDAFF58qBx0#pileated-gibbon"]},
    {"id":"squirrel-monkey","commonName":"Squirrel Monkey","scientificName":null,"taxonScope":"Saimiri","group":"New World monkey","facts":["A small, highly social monkey of Central and South American forests.","Large troops may contain many dozens of individuals.","It forages actively for fruit and insects."],"sourceRefs":["youtube-lDAFF58qBx0#squirrel-monkey"]},
    {"id":"guereza","commonName":"Mantled Guereza","scientificName":"Colobus guereza","group":"Old World monkey","facts":["A black-and-white colobus monkey native to African forests.","A specialized multi-chambered stomach helps digest leaves.","Long-distance calls help neighboring groups space themselves."],"sourceRefs":["youtube-lDAFF58qBx0#guereza"]},
    {"id":"de-brazzas-monkey","commonName":"De Brazza’s Monkey","scientificName":"Cercopithecus neglectus","group":"Old World monkey","facts":["Associated with swampy forests and waterways in central Africa.","Its white beard and orange brow make it visually distinctive.","It may freeze and remain motionless to avoid detection."],"sourceRefs":["youtube-lDAFF58qBx0#debrazza-monkey"]},
    {"id":"diana-monkey","commonName":"Diana Monkey","scientificName":"Cercopithecus diana","group":"Old World monkey","facts":["Native to West African rainforests.","It uses distinct alarm calls in response to different threats.","Mixed-species associations can share information about predators."],"sourceRefs":["youtube-lDAFF58qBx0#diana-monkey"]},
    {"id":"mona-monkey","commonName":"Mona Monkey","scientificName":"Cercopithecus mona","group":"Old World monkey","facts":["A colorful forest monkey native to West Africa.","It is agile in the canopy and eats fruit, seeds, leaves, and insects.","Cheek pouches allow it to carry food away from a feeding site."],"sourceRefs":["youtube-lDAFF58qBx0#mona-monkey"]},
    {"id":"barbary-macaque","commonName":"Barbary Macaque","scientificName":"Macaca sylvanus","group":"Old World monkey","facts":["The only macaque native to Africa and the only wild nonhuman primate in Europe.","It has only a vestigial tail.","Males participate extensively in infant care."],"sourceRefs":["youtube-lDAFF58qBx0#barbary-macaque"]},
    {"id":"bonnet-macaque","commonName":"Bonnet Macaque","scientificName":"Macaca radiata","group":"Old World monkey","facts":["Native to southern India and named for the radiating hair whorl on its crown.","It is highly adaptable and often lives near people.","Troops have complex dominance and social relationships."],"sourceRefs":["youtube-lDAFF58qBx0#bonnet-monkey"]},
    {"id":"crested-black-macaque","commonName":"Crested Black Macaque","scientificName":"Macaca nigra","group":"Old World monkey","facts":["Native to Sulawesi and nearby Indonesian islands.","It has black fur, a prominent crest, and a very short tail.","Facial expressions and affiliative contact are important in its social life."],"sourceRefs":["youtube-lDAFF58qBx0#crested-black-macaque"]},
    {"id":"rhesus-macaque","commonName":"Rhesus Macaque","scientificName":"Macaca mulatta","group":"Old World monkey","facts":["One of the most geographically widespread nonhuman primates.","It is highly adaptable to forests, grasslands, villages, and cities.","Its social groups are organized through strong dominance relationships."],"sourceRefs":["youtube-lDAFF58qBx0#rhesus-monkey"]},
    {"id":"drill","commonName":"Drill","scientificName":"Mandrillus leucophaeus","group":"Old World monkey","facts":["A large forest monkey of Nigeria, Cameroon, and Bioko Island.","It forages on the ground for fruit, seeds, roots, and animal prey.","Habitat loss and hunting have made it critically endangered."],"sourceRefs":["youtube-lDAFF58qBx0#drill"]},
    {"id":"mandrill","commonName":"Mandrill","scientificName":"Mandrillus sphinx","group":"Old World monkey","facts":["The world’s largest monkey species.","Adult male facial and rump coloration intensifies with social and reproductive status.","Very large aggregations are known as hordes."],"sourceRefs":["youtube-lDAFF58qBx0#mandrill"]},
    {"id":"patas-monkey","commonName":"Patas Monkey","scientificName":"Erythrocebus patas","group":"Old World monkey","facts":["A long-limbed terrestrial monkey adapted to African savannas and semi-arid grasslands.","It is widely described as the fastest primate runner.","Males may draw predator attention while females and young escape."],"sourceRefs":["youtube-lDAFF58qBx0#patas-monkey"]},
    {"id":"snub-nosed-monkey","commonName":"Snub-nosed Monkey","scientificName":null,"taxonScope":"Rhinopithecus","group":"Old World monkey","facts":["The genus contains mountain-forest species in China, Vietnam, and Myanmar.","Thick fur supports life at high elevations and in cold winters.","Some populations form very large multi-level societies."],"sourceRefs":["youtube-lDAFF58qBx0#snub-nosed-monkey"]},
    {"id":"allens-swamp-monkey","commonName":"Allen’s Swamp Monkey","scientificName":"Allenopithecus nigroviridis","group":"Old World monkey","facts":["A semi-aquatic primate of Congo Basin swamp forests.","Partially webbed digits aid swimming and underwater foraging.","It may dive into water to escape predators."],"sourceRefs":["youtube-lDAFF58qBx0#swamp-monkey"]},
    {"id":"talapoin","commonName":"Talapoin","scientificName":null,"taxonScope":"Miopithecus","group":"Old World monkey","facts":["Talapoins are the smallest Old World monkeys.","They live near swamp forest and river habitats in central Africa.","Large troops sleep in vegetation overhanging water and readily swim to escape danger."],"sourceRefs":["youtube-lDAFF58qBx0#talapoin"]},
    {"id":"vervet-monkey","commonName":"Vervet Monkey","scientificName":"Chlorocebus pygerythrus","group":"Old World monkey","facts":["A widespread, adaptable African primate of savanna, woodland, and riverine habitats.","Distinct alarm calls elicit predator-specific escape responses.","It is an opportunistic omnivore and often succeeds near human settlements."],"sourceRefs":["youtube-lDAFF58qBx0#vervet-monkey"]}
  ],
