<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the saved game goes to the player's Google backup and moves to a new phone; nothing else does. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="monkeytrubble.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="monkeytrubble.xml" />
    </device-transfer>
</data-extraction-rules>
