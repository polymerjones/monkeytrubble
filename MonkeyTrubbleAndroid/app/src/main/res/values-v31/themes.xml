<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MonkeyTrubble" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:colorBackground">@color/launch_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Android 12+ always shows a system splash: match it to the game's loading screen. -->
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
    </style>
</resources>
