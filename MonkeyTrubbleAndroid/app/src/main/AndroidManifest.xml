<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The game runs in portrait, but a portrait screen isn't required: without this, Play hides the app from devices that don't
         report one (tablets, Chromebooks, Play Games on PC) and blocks the release (Play Console, 2026-11-18). -->
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />

    <!-- Supabase world records and leaderboard, and AdMob. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Haptics (a normal permission, granted at install). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Streak reminders (Reminders.kt): asked only from Settings, and re-armed after a restart. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- appCategory="game": Android 16 (targetSdk 36) ignores the portrait lock on tablets and foldables, but not for games. -->
    <application
        android:name=".MonkeyApp"
        android:appCategory="game"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.MonkeyTrubble">

        <meta-data
            android:name="com.google.android.gms.games.APP_ID"
            android:value="@string/game_services_project_id" />

        <!-- AdMob rewarded ads (Ads.kt). -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <!-- Shared puzzle pictures (Share.kt) are handed to other apps from the cache through this provider. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver android:name=".ReminderReceiver" android:exported="false" />
        <receiver android:name=".ReminderBootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Friend links (2026-11-17): https://monkeytrubble.app/f/CODE opens the game on that player's card (App Links, verified by
                 web/.well-known/assetlinks.json). singleTask: a link reuses the running game instead of starting a second copy. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="monkeytrubble.app" android:pathPrefix="/f/" />
            </intent-filter>
        </activity>
    </application>
</manifest>
